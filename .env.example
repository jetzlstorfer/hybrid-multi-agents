# Microsoft Foundry project for the cloud agents.
FOUNDRY_PROJECT_ENDPOINT=https://my-foundry-project.services.ai.azure.com

# Optional: send OpenTelemetry traces to the Foundry project's Tracing tab.
# Without this, spans go to the console only.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Override any model from models.yaml without editing the file.
# HYBRID_DEMO__EDGE__SLM__MODEL=phi-4-mini-reasoning
# HYBRID_DEMO__EDGE__TRANSCRIPTION__MODEL=whisper-tiny
# HYBRID_DEMO__CLOUD__RESEARCH__MODEL=gpt-5.4

# Path to the model registry; useful when running in a container.
HYBRID_DEMO_MODELS_FILE=models.yaml

# Transcription backend and model (faster-whisper is recommended on Linux/WSL)
TRANSCRIPTION_BACKEND=faster-whisper
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE=int8

# Stage timeouts (seconds)
HYBRID_DEMO_TRANSCRIPTION_TIMEOUT_SECONDS=900
HYBRID_DEMO_EDGE_TIMEOUT_SECONDS=300
HYBRID_DEMO_PII_TIMEOUT_SECONDS=900

# PII second-pass audit (extra recall, but slower)
HYBRID_DEMO_SKIP_PII_AUDIT=1
