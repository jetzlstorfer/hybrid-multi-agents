# Normalize line endings to LF for text files to avoid CRLF issues on Linux/macOS.
* text=auto eol=lf

# Explicitly enforce LF for shell scripts and Python (shebang lines break with CRLF).
*.sh   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Binary files
*.png  binary
*.jpg  binary
*.gif  binary
*.wav  binary
*.mp3  binary
